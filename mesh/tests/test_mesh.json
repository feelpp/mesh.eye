{
    "Name": "test_mesh",
    "Meshes":
    {
        "heat":
        {
            "Import":
            {
                "filename":"$cfgdir/../Eye_Mesh3D.msh",
                "partition": 0
            }
        }
    },
    "Models":
    {
        "heat": {"name": "heat"}
    },
    "Parameters":
    {
        "h_bl": 65,         // [W / m^2 / K]
        "h_amb": 10,        // [W / m^2 / K]        \cite{KOSKY2013259}
        "T_bl": 310,        // [K] 36.85°C          \cite{https://hypertextbook.com/facts/1997/LenaWong.shtml}
        "T_amb": 294,       // [K] 24.85°C          \cite{MAPSTONE1968237}
        "E": 40,            // [W / m^2]            \cite{Scott_1988}
        "sigma": 5.67e-8,   // [W / (m^2 * K^4)]
        "epsilon": 0.974   // [-]                  \cite{MAPSTONE1968237}
    },
    "Materials":
    {
        "Cornea": {"k": 0.58},
        "Sclera": {"k": 1.0042},
        "AqueousHumor": {"k": 0.578},
        "Lens": {"k": 0.40},
        "Iris": {"k": 1.0042},
        "Lamina": {"k": 1.0042},
        "Choroid": {"k": 0.52},
        "OpticNerve": {"k": 1.0042}
    },

    "BoundaryConditions":
    {
        "heat":
        {
            "convective_heat_flux":
            {
                "BC_Sclera":
                {
                    "h":"h_bl:h_bl",
                    "Text":"T_bl:T_bl"
                },
                "BC_OpticNerve":
                {
                    "h":"h_bl:h_bl",
                    "Text":"T_bl:T_bl"
                }
            },
            "flux":
            {
                "BC_Cornea":
                {
                    "expr":"-(h_amb * (heat_T - T_amb) + sigma * epsilon * (heat_T * heat_T * heat_T * heat_T - T_amb * T_amb * T_amb * T_amb) + E):heat_T:T_amb:h_amb:epsilon:sigma:E"
                }
            }
        }
    },

    "PostProcess":
    {
        "use-model-name":1,
        "heat":
        {
            "Exports":
            {
                "fields":["temperature", "marker", "pid"]
            },
            "Measures":
            {
                "Statistics":
                {
                    "eye":
                    {
                        "type":["min","max","mean"],
                        "field":"temperature"
                    },
                    "cornea":
                    {
                        "type":["min","max","mean"],
                        "field":"temperature",
                        "markers":"Cornea"
                    }
                }
            }
        }
    }

}
